# syntax=docker/dockerfile:1.7

# Release images package binaries produced by the native Linux matrix jobs.
# The regular Dockerfile remains the standalone source build used locally.
FROM ubuntu:26.04 AS runtime-root

ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgcc-s1 \
        libsasl2-2 \
        libssl3t64 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY release-context/${TARGETARCH}/pgmq-relay /usr/local/bin/pgmq-relay

RUN set -eux; \
    mkdir -p /rootfs/etc/ssl/certs /rootfs/home/pgmq-relay; \
    cp --parents /usr/local/bin/pgmq-relay /rootfs; \
    cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/; \
    ldd /usr/local/bin/pgmq-relay \
        | awk '/=> \// { print $3 } /^[[:space:]]*\// { print $1 }' \
        | sort -u \
        | xargs -r cp --parents --target-directory=/rootfs

FROM scratch

COPY --from=runtime-root /rootfs /
COPY docker/config-docker.toml /etc/pgmq-relay/config.toml

USER 10001:10001
WORKDIR /home/pgmq-relay

EXPOSE 9090
ENV RUST_LOG=info

CMD ["pgmq-relay", "--config", "/etc/pgmq-relay/config.toml"]
