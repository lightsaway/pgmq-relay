# pgmq-relay environment variables
#
# PGMQ_RELAY_CONNECTION_URL always wins over the TOML file, so the database password
# never has to live in a config file. The PGMQ_RELAY_DEFAULT_* variables below only
# apply when the corresponding TOML field is omitted.

# --- PGMQ --------------------------------------------------------------------
# PGMQ_RELAY_CONNECTION_URL=postgres://user:pass@localhost:5432/db

# --- Logging -----------------------------------------------------------------
RUST_LOG=pgmq_relay=info
LOG_FORMAT=text                 # text | json

# --- Queue defaults ----------------------------------------------------------
PGMQ_RELAY_DEFAULT_PARALLELISM=1
PGMQ_RELAY_DEFAULT_BATCH_SIZE=10
PGMQ_RELAY_DEFAULT_POLL_INTERVAL=250ms
PGMQ_RELAY_DEFAULT_VISIBILITY_TIMEOUT=30
PGMQ_RELAY_DEFAULT_MAX_CONNECTIONS=10

# --- Kafka broker ------------------------------------------------------------
PGMQ_RELAY_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PGMQ_RELAY_KAFKA_SECURITY_PROTOCOL=SASL_SSL
# PGMQ_RELAY_KAFKA_SASL_MECHANISM=PLAIN
# PGMQ_RELAY_KAFKA_SASL_USERNAME=user
# PGMQ_RELAY_KAFKA_SASL_PASSWORD=pass

# --- RabbitMQ broker ---------------------------------------------------------
# PGMQ_RELAY_RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

# --- NATS broker -------------------------------------------------------------
# PGMQ_RELAY_NATS_URL=nats://localhost:4222

# --- Circuit breaker ---------------------------------------------------------
PGMQ_RELAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PGMQ_RELAY_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30s
